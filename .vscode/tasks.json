{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run recorder",
            "type": "cargo",
            "command": "run",
            "args": [
                "--example",
                "recorder"
            ],
            "options": {
                "env": {
                    "RUST_LOG": "debug",
                    "RUST_BACKTRACE": "1",
                }
            },
        },
        {
            "label": "run replayer",
            "type": "cargo",
            "command": "run",
            "args": [
                "--example",
                "replayer"
            ],
            "options": {
                "env": {
                    "RUST_LOG": "debug",
                    "RUST_BACKTRACE": "1",
                }
            },
        },
        {
            "label": "test",
            "type": "cargo",
            "command": "test",
            "args": [
                "--all-targets",
                "--all-features",
                "--workspace",
            ],
        },
        {
            "label": "test macaw-http",
            "type": "cargo",
            "command": "test",
            "args": [
                "--all-targets",
                "--all-features",
            ],
            "options": {
                "cwd": "${workspaceFolder}/macaw-http"
            },
        },
        {
            "label": "test macaw-ws",
            "type": "cargo",
            "command": "test",
            "args": [
                "--all-targets",
                "--all-features",
            ],
            "options": {
                "cwd": "${workspaceFolder}/macaw-ws"
            },
        },
        {
            "label": "clippy",
            "type": "cargo",
            "command": "clippy",
            "args": [
                "--all-targets",
                "--all-features",
                "--workspace",
            ],
        },
    ]
}